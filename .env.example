# KAIROS - Environment Variables Template
# Copiar a .env y llenar con tus valores
# NUNCA commitear .env al repo - agregar a .gitignore

# DJANGO
DEBUG=False
SECRET_KEY=<GENERAR CON: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'>
ALLOWED_HOSTS=localhost,127.0.0.1,tu-app.ondigitalocean.app

# DATABASE (PostgreSQL en DigitalOcean)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kairos_prod
DB_USER=dbuser
DB_PASSWORD=<GENERAR FUERTE - mínimo 20 caracteres>
DB_HOST=xxxx.ondigitalocean.com
DB_PORT=25060

# CANVAS OAUTH (Obtener de tu Canvas instance admin settings)
CANVAS_BASE_URL=https://tu-canvas-instance.com
CANVAS_CLIENT_ID=<Tu Canvas App ID>
CANVAS_CLIENT_SECRET=<Tu Canvas App Secret>
CANVAS_REDIRECT_URI=http://localhost:8000/callback

# DEEPSEEK API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=<Tu DeepSeek API Key>

# OPENAI API — Used for GPT-4o-mini vision OCR (image/math extraction)
OPENAI_API_KEY=<Tu OpenAI API Key>

# GOOGLE CREDENTIALS (Si usas Google Embeddings - OPCIONAL)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/credentials.json

# STORAGE (DigitalOcean Spaces - OPCIONAL)
SPACES_ACCESS_KEY=<Tu Spaces Access Key>
SPACES_SECRET_KEY=<Tu Spaces Secret Key>
SPACES_BUCKET=kairos-static

# LOGGING
LOG_LEVEL=INFO
