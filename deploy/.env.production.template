# ============================================
# Kairos — Production Environment Template
# Copy to /home/ubuntu/Kairos/.env and fill in
# ============================================

# ── Django ──────────────────────────────────
DJANGO_SECRET_KEY=          # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False
ALLOWED_HOSTS_EXTRA=tu-dominio.com,IP_PUBLICA_DROPLET
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# ── Base de datos (PostgreSQL) ──────────────
DATABASE_URL=postgres://kairos_user:CONTRASEÑA_SEGURA@localhost:5432/kairos_db

# ── Canvas OAuth2 ───────────────────────────
CANVAS_BASE_URL=https://tu-canvas.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=https://tu-dominio.com/canvas/callback/

# ── DeepSeek API ────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_TEACHER_API_KEY=sk-...

# ── Gunicorn ────────────────────────────────
PORT=8000
