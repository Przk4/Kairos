[Unit]
Description=Kairos Django Application (Gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Kairos
EnvironmentFile=/home/ubuntu/Kairos/.env
ExecStart=/home/ubuntu/Kairos/venv/bin/gunicorn kairos_project.wsgi:application -c gunicorn.conf.py
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kairos

[Install]
WantedBy=multi-user.target
